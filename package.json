{
  "name": "swim-flow-api",
  "version": "1.0.0",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "prisma:generate": "node ./node_modules/prisma/build/index.js generate --schema prisma/schema.prisma",
    "seed:smoke": "ts-node --transpile-only scripts/seed-smoke.ts",
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "format:changed": "node scripts/check-changed-prettier.cjs",
    "format:changed:test": "node --test scripts/check-changed-prettier.test.cjs",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main.js",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:unit": "jest --runInBand",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json --runInBand",
    "test:all": "npm run test:unit && npm run test:e2e",
    "prisma:validate": "prisma validate --schema prisma/schema.prisma",
    "prisma:migrate:dev": "prisma migrate dev --schema prisma/schema.prisma",
    "prisma:migrate:deploy": "prisma migrate deploy --schema prisma/schema.prisma",
    "lint:check": "eslint \"{src,apps,libs,test}/**/*.ts\"",
    "neon:preflight": "node scripts/neon-preflight.cjs",
    "neon:preflight:test": "node --test scripts/neon-preflight.test.cjs",
    "neon:inspect": "node scripts/neon-inspect.cjs",
    "neon:inspect:test": "node --test scripts/neon-inspect.test.cjs",
    "neon:staging:migrate": "node scripts/neon-staging-migrate.cjs",
    "neon:staging:migrate:test": "node --test scripts/neon-staging-migrate.test.cjs",
    "neon:local-auth:staging": "node scripts/neon-local-auth-staging.cjs",
    "neon:local-auth:staging:test": "node --test scripts/neon-local-auth-staging.test.cjs",
    "private-media:staging": "node scripts/private-media-staging-migrate.cjs",
    "private-media:staging:test": "node --test scripts/private-media-staging-migrate.test.cjs",
    "private-media:staging:audit": "node scripts/private-media-staging-audit.cjs",
    "render:blueprint:test": "node --test scripts/render-blueprint.test.cjs",
    "prisma:migrate:status": "prisma migrate status --schema prisma/schema.prisma",
    "bootstrap:first-admin:invite": "node scripts/bootstrap-first-admin.cjs --apply",
    "bootstrap:first-admin:resend": "node scripts/bootstrap-first-admin.cjs --resend",
    "bootstrap:first-admin:test": "node --test scripts/bootstrap-first-admin.test.cjs scripts/bootstrap-disposable-guard.test.cjs",
    "resend:smoke": "node scripts/resend-delivery-smoke.cjs --send",
    "resend:smoke:test": "node --test scripts/resend-delivery-smoke.test.cjs",
    "r2:smoke:guard:test": "node --test scripts/private-r2-smoke-guard.test.cjs scripts/private-r2-smoke-http.test.cjs scripts/private-r2-smoke-workflow.test.cjs",
    "r2:smoke:live": "node -r ts-node/register/transpile-only -r tsconfig-paths/register scripts/verify-private-media-r2-live.cjs --execute",
    "blob:smoke:guard:test": "node --test scripts/private-blob-smoke-guard.test.cjs scripts/private-blob-smoke-live.test.cjs scripts/private-blob-smoke-workflow.test.cjs",
    "blob:smoke:live": "node -r ts-node/register/transpile-only -r tsconfig-paths/register scripts/verify-private-blob-live.cjs --execute"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1156.0",
    "@aws-sdk/s3-request-presigner": "3.1156.0",
    "@nestjs/common": "^11.0.1",
    "@nestjs/core": "^11.0.1",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/platform-express": "^11.0.1",
    "@nestjs/swagger": "^11.2.0",
    "@prisma/client": "^6.19.3",
    "@supabase/supabase-js": "^2.98.0",
    "@types/cookie-parser": "^1.4.10",
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.7",
    "express": "^5.1.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "swagger-ui-express": "^5.0.1",
    "zod": "^3.25.76",
    "@vercel/blob": "2.8.2",
    "sharp": "0.35.5"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@eslint/js": "^9.18.0",
    "@faker-js/faker": "^10.4.0",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.1",
    "@types/express": "^5.0.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.0.0",
    "@types/supertest": "^7.0.0",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.2.2",
    "globals": "^17.0.0",
    "jest": "^30.0.0",
    "prettier": "^3.4.2",
    "prisma": "^6.19.3",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": ".",
    "testRegex": "(/src/.*|/test/.*)\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "src/**/*.(t|j)s"
    ],
    "coverageDirectory": "./coverage",
    "testEnvironment": "node",
    "moduleNameMapper": {
      "^@/(.*)$": "<rootDir>/src/$1"
    }
  }
}

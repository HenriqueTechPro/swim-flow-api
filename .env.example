# Neon pooled endpoint for runtime. Use sslmode=require and connection_limit=1 where appropriate.
DATABASE_URL=postgresql://USER:PASSWORD@YOUR-NEON-POOLER-HOST/neondb?sslmode=require
# Neon direct (non-pooler) endpoint for Prisma migrations.
DIRECT_URL=postgresql://USER:PASSWORD@YOUR-NEON-DIRECT-HOST/neondb?sslmode=require
# Optional, legacy Supabase Auth/Storage only.
# Omit ALL these keys for Neon-only staging. The legacy endpoints return 503.
# VITE_SUPABASE_URL=https://example.supabase.co
# VITE_SUPABASE_PUBLISHABLE_KEY=replace-for-legacy-auth
# SUPABASE_SECRET_KEY=replace-for-legacy-admin-and-storage
# SUPABASE_SERVICE_ROLE_KEY=legacy-fallback-not-recommended
JWT_ACCESS_SECRET=replace-with-a-long-random-secret-with-at-least-32-characters
JWT_ACCESS_TTL_SECONDS=900
# Explicitly enable only after creating and verifying the initial admin.
SWIMFLOW_LOCAL_PASSWORD_LOGIN_ENABLED=false
REFRESH_TOKEN_TTL_DAYS=7
AUTH_REFRESH_COOKIE_NAME=swim_flow_refresh_token
AUTH_COOKIE_SAME_SITE=lax
AUTH_COOKIE_DOMAIN=
AUTH_COOKIE_PATH=/api/auth
AUTH_SECURE_COOKIES=false
API_CORS_ORIGIN=http://localhost:8080
NEST_API_PORT=3334
# Optional: Render supplies PORT, which takes precedence over NEST_API_PORT.
# PORT=10000
CACHE_TTL_SECONDS=30
SWAGGER_ENABLED=true
SWAGGER_PATH=docs

# Future private media on Cloudflare R2 (S3-compatible).
# NOT active in this stage: existing upload API still uses the legacy adapter.
# Never use VITE_S3_* variables or commit live credentials.
SWIMFLOW_PRIVATE_MEDIA_S3_ENABLED=false
# S3_ENDPOINT=https://YOUR_ACCOUNT_ID.r2.cloudflarestorage.com
# S3_REGION=auto
# S3_BUCKET=swim-flow-private-media
# S3_ACCESS_KEY_ID=replace-locally-on-render-only
# S3_SECRET_ACCESS_KEY=replace-locally-on-render-only

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
  
}

enum AppRole {
  user
  teacher
  admin

  @@map("app_role")
}

enum Gender {
  Masculino
  Feminino

  @@map("gender")
}

enum EntityStatus {
  Ativo
  Licenca @map("Licença")
  Inativo

  @@map("entity_status")
}

enum EntityStatusActive {
  Ativo
  Inativo

  @@map("entity_status_active")
}

enum SwimmingCategory {
  Pre_Mirim @map("Pré-Mirim")
  Mirim_1 @map("Mirim 1")
  Mirim_2 @map("Mirim 2")
  Petiz_1 @map("Petiz 1")
  Petiz_2 @map("Petiz 2")
  Infantil_1 @map("Infantil 1")
  Infantil_2 @map("Infantil 2")
  Juvenil_1 @map("Juvenil 1")
  Juvenil_2 @map("Juvenil 2")
  Junior_1 @map("Júnior 1")
  Junior_2 @map("Júnior 2")
  Senior @map("Sênior")
  Pre_Master @map("Pré-Master")
  Master_A @map("Master A")
  Master_B @map("Master B")
  Master_C @map("Master C")
  Master_D @map("Master D")
  Master_E @map("Master E")
  Master_F @map("Master F")
  Master_G @map("Master G")
  Master_H @map("Master H")
  Master_I @map("Master I")
  Master_J @map("Master J")
  Master_K @map("Master K")
  Master_L @map("Master L")
  Master_M @map("Master M")
  Master_N @map("Master N")
  Master_O @map("Master O")

  @@map("swimming_category")
}

enum SeasonStatus {
  PLANNED
  ACTIVE
  CLOSED

  @@map("season_status")
}

enum GuardianRelationship {
  MOTHER
  FATHER
  GRANDPARENT
  LEGAL_GUARDIAN
  OTHER

  @@map("guardian_relationship")
}

enum CoachRole {
  head_coach
  assistant_coach

  @@map("coach_role")
}

enum ClassStatus {
  Ativa
  Pausada
  Encerrada

  @@map("class_status")
}

enum EventStatus {
  Agendado
  Em_Andamento @map("Em Andamento")
  Concluido @map("Concluído")
  Cancelado

  @@map("event_status")
}

enum TipoEvento {
  Competicao @map("Competição")
  Reuniao @map("Reunião")
  Festival

  @@map("tipo_evento")
}

enum PoolStatus {
  Ativa
  Inativa
  Manutencao @map("Manutenção")

  @@map("pool_status")
}

enum TipoTreino {
  Tecnico @map("Técnico")
  Resistencia @map("Resistência")
  Velocidade
  Misto

  @@map("tipo_treino")
}

enum NivelTreino {
  Iniciante
  Intermediario @map("Intermediário")
  Avancado @map("Avançado")
  Todos

  @@map("nivel_treino")
}

enum TrainingStatus {
  Ativo
  Pausado
  Encerrado

  @@map("training_status")
}

enum TrainingVenueType {
  Piscina
  Mar
  Represa

  @@map("training_venue_type")
}

enum ExStudentExitReason {
  Mudanca_de_cidade @map("Mudança de cidade")
  Falta_de_tempo @map("Falta de tempo")
  Interesse_por_outro_esporte @map("Interesse por outro esporte")
  Idade_limite_da_categoria @map("Idade limite da categoria")
  Motivos_financeiros @map("Motivos financeiros")
  Motivos_de_saude @map("Motivos de saúde")
  Outro

  @@map("ex_student_exit_reason")
}

enum AttendanceStatus {
  present
  absent
  late
  justified

  @@map("attendance_status")
}

enum SwimmingStyle {
  Livre
  Costas
  Peito
  Borboleta
  Medley

  @@map("swimming_style")
}

// New, strongly typed competitive-result domain. Legacy Result remains until
// its HTTP/repository consumers migrate in the next PR, before the Neon baseline.
enum RaceResultStatus {
  PENDING
  CLASSIFIED
  DISQUALIFIED
  DID_NOT_START
  DID_NOT_FINISH

  @@map("race_result_status")
}

enum PoolResultFormat {
  INDIVIDUAL
  RELAY

  @@map("pool_result_format")
}

enum OpenWaterResultFormat {
  INDIVIDUAL
  RELAY
  TRAVESSIA
  KNOCKOUT_SPRINT
  ULTRAMARATHON

  @@map("open_water_result_format")
}

enum OpenWaterBodyType {
  SEA
  RIVER
  LAKE
  RESERVOIR

  @@map("open_water_body_type")
}

model Profile {
  id        String   @id @db.Uuid
  fullName  String   @default("") @map("full_name")
  avatarUrl String?  @map("avatar_url")
  role      AppRole  @default(user)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)
  authSessions AuthSession[]
  teacher      Teacher? @relation("TeacherAccount")

  @@map("profiles")
}

model AuthSession {
  id                  String       @id @default(uuid()) @db.Uuid
  userId              String       @map("user_id") @db.Uuid
  email               String
  refreshTokenHash    String       @map("refresh_token_hash")
  expiresAt           DateTime     @map("expires_at") @db.Timestamptz(6)
  revokedAt           DateTime?    @map("revoked_at") @db.Timestamptz(6)
  replacedBySessionId String?      @map("replaced_by_session_id") @db.Uuid
  userAgent           String?      @map("user_agent")
  ipAddress           String?      @map("ip_address")
  createdAt           DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime     @default(now()) @map("updated_at") @db.Timestamptz(6)
  profile             Profile      @relation(fields: [userId], references: [id], onDelete: Cascade)
  replacedBySession   AuthSession? @relation("AuthSessionReplacement", fields: [replacedBySessionId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  previousSessions    AuthSession[] @relation("AuthSessionReplacement")

  @@map("auth_sessions")
  @@index([userId, revokedAt])
  @@index([expiresAt])
  @@index([refreshTokenHash])
}

// Season of reference for competitive-age classification. Historical categories
// are snapshots per season, not a mutable property derived from the current year.
model Season {
  id                  String                  @id @default(uuid()) @db.Uuid
  year                Int                     @unique
  label               String
  startsOn            DateTime                @map("starts_on") @db.Date
  endsOn              DateTime                @map("ends_on") @db.Date
  status              SeasonStatus            @default(PLANNED)
  createdAt           DateTime                @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime                @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  studentCategories   StudentSeasonCategory[]
  events              Event[]
  poolResults         PoolResult[]
  openWaterResults    OpenWaterResult[]

  @@index([status, year])
  @@map("seasons")
}

model StudentSeasonCategory {
  id         String   @id @default(uuid()) @db.Uuid
  studentId  String   @map("student_id") @db.Uuid
  seasonId   String   @map("season_id") @db.Uuid
  categoryId String   @map("category_id") @db.Uuid
  assignedAt DateTime @default(now()) @map("assigned_at") @db.Timestamptz(6)
  notes      String?
  student    Student  @relation(fields: [studentId], references: [id], onDelete: Restrict)
  season     Season   @relation(fields: [seasonId], references: [id], onDelete: Restrict)
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  @@unique([studentId, seasonId])
  @@index([seasonId, categoryId])
  @@index([categoryId])
  @@map("student_season_categories")
}

model Category {
  id        String           @id @default(uuid()) @db.Uuid
  name      SwimmingCategory @unique
  ageMin    Int?             @map("age_min")
  ageMax    Int?             @map("age_max")
  sortOrder Int              @default(0) @map("sort_order")
  createdAt DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  students          Student[]
  teacherCategories TeacherCategory[]
  swimmingClasses   SwimmingClass[]
  classCategories   ClassCategory[]
  studentSeasonCategories StudentSeasonCategory[]

  @@map("categories")
}

model Level {
  id          String    @id @default(uuid()) @db.Uuid
  name        String    @unique
  description String?
  sortOrder   Int       @default(0) @map("sort_order")
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  students             Student[]
  levelHistoryFrom      StudentLevelHistory[] @relation("PreviousStudentLevel")
  levelHistoryTo        StudentLevelHistory[] @relation("NewStudentLevel")

  @@map("levels")
}

model Parent {
  id               String             @id @default(uuid()) @db.Uuid
  name             String
  photo            String?
  cpf              String?
  birthDate        DateTime?          @map("birth_date") @db.Date
  phone            String             @default("")
  email            String             @default("")
  profession       String             @default("")
  address          String             @default("")
  emergencyContact String             @default("") @map("emergency_contact")
  emergencyPhone   String             @default("") @map("emergency_phone")
  status           EntityStatusActive @default(Ativo)
  createdAt        DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime           @default(now()) @map("updated_at") @db.Timestamptz(6)
  exStudents       ExStudent[]
  studentGuardians StudentGuardian[]

  @@map("parents")
}

model ExStudent {
  id              String              @id @default(uuid()) @db.Uuid
  studentId       String              @map("student_id") @db.Uuid
  name            String
  category        String
  exitDateAt      DateTime            @map("exit_date_at") @db.Date
  exitReason      ExStudentExitReason @map("exit_reason")
  exitNotes       String?             @map("exit_notes")
  phone           String              @default("")
  responsible     String              @default("")
  parentId        String?             @map("parent_id") @db.Uuid
  achievements    Int                 @default(0)
  lastCompetition String              @default("") @map("last_competition")
  birthDate       DateTime?           @map("birth_date") @db.Date
  level           String              @default("")
  reactivatedAt   DateTime?           @map("reactivated_at") @db.Timestamptz(6)
  voidedAt        DateTime?           @map("voided_at") @db.Timestamptz(6)
  createdAt       DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime            @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  student         Student             @relation(fields: [studentId], references: [id], onDelete: Restrict)
  parent          Parent?             @relation(fields: [parentId], references: [id], onDelete: SetNull)

  @@index([studentId, exitDateAt])
  @@index([reactivatedAt, voidedAt, exitDateAt])
  @@map("ex_students")
}

model Event {
  id          String      @id @default(uuid()) @db.Uuid
  title       String
  description String      @default("")
  type        TipoEvento
  date        DateTime?   @db.Date
  startTime   DateTime    @map("start_time") @db.Time(6)
  endTime     DateTime    @map("end_time") @db.Time(6)
  location    String      @default("")
  status      EventStatus @default(Agendado)
  createdAt   DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime    @default(now()) @map("updated_at") @db.Timestamptz(6)
  poolResults PoolResult[]
  openWaterResults OpenWaterResult[]
  seasonId    String? @map("season_id") @db.Uuid
  season      Season? @relation(fields: [seasonId], references: [id], onDelete: SetNull)

  @@map("events")
  @@index([seasonId, date])
  @@index([date, status])
}

model Teacher {
  id                    String                 @id @default(uuid()) @db.Uuid
  name                  String
  photo                 String?
  speciality            String                 @default("")
  experience            Int                    @default(0)
  phone                 String                 @default("")
  email                 String                 @default("")
  status                EntityStatus           @default(Ativo)
  birthDate             DateTime?              @map("birth_date") @db.Date
  address               String?
  bio                   String?
  createdAt             DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime               @default(now()) @map("updated_at") @db.Timestamptz(6)
  cpf                   String?
  profileId             String?                @unique @map("profile_id") @db.Uuid
  profile               Profile?               @relation("TeacherAccount", fields: [profileId], references: [id], onDelete: SetNull)
  teacherCategories     TeacherCategory[]
  teacherCertifications TeacherCertification[]
  classTeachers         ClassTeacher[]
  trainings                  Training[]
  anthropometricAssessments  AnthropometricAssessment[] @relation("AnthropometricAssessor")
  technicalAssessments       StudentTechnicalAssessment[] @relation("TechnicalAssessor")
  levelChanges               StudentLevelHistory[] @relation("LevelChangeAssessor")

  @@map("teachers")
}

model Student {
  id              String       @id @default(uuid()) @db.Uuid
  name            String
  gender          Gender       @default(Masculino)
  birthDate       DateTime?    @map("birth_date") @db.Date
  categoryId      String       @map("category_id") @db.Uuid
  levelId         String       @map("level_id") @db.Uuid
  phone           String       @default("")
  status          EntityStatus @default(Ativo)
  achievements    Int          @default(0)
  photo           String?
  createdAt       DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime     @default(now()) @map("updated_at") @db.Timestamptz(6)
  category        Category     @relation(fields: [categoryId], references: [id])
  level           Level        @relation(fields: [levelId], references: [id])
  guardians       StudentGuardian[]
  exStudents      ExStudent[]
  poolResults     PoolResult[]
  openWaterResults OpenWaterResult[]
  studentClasses  StudentClass[]
  attendanceRecords        AttendanceRecord[]
  anthropometricAssessments AnthropometricAssessment[]
  technicalAssessments     StudentTechnicalAssessment[]
  levelHistory             StudentLevelHistory[]
  seasonCategories        StudentSeasonCategory[]

  @@map("students")
  @@index([categoryId, levelId])
  @@index([status, createdAt])
}

// A swimmer can have multiple authorized adults. Only one link may be marked
// isPrimary=true per swimmer (enforced by a partial UNIQUE index in baseline SQL).
// The HTTP parentId property is a projection of this relation, not stored twice.
model StudentGuardian {
  id                String               @id @default(uuid()) @db.Uuid
  studentId         String               @map("student_id") @db.Uuid
  parentId          String               @map("parent_id") @db.Uuid
  isPrimary         Boolean              @default(false) @map("is_primary")
  relationship      GuardianRelationship @default(OTHER)
  canReceiveUpdates Boolean              @default(false) @map("can_receive_updates")
  createdAt         DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime             @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  student           Student              @relation(fields: [studentId], references: [id], onDelete: Cascade)
  parent            Parent               @relation(fields: [parentId], references: [id], onDelete: Cascade)

  @@unique([studentId, parentId])
  @@index([parentId, isPrimary])
  @@index([studentId, isPrimary])
  @@map("student_guardians")
}

model SwimmingClass {
  id            String         @id @default(uuid()) @db.Uuid
  name          String
  categoryId    String         @map("category_id") @db.Uuid
  maxStudents   Int            @default(10) @map("max_students")
  poolId        String?        @map("pool_id") @db.Uuid
  status        ClassStatus    @default(Ativa)
  createdAt     DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime       @default(now()) @map("updated_at") @db.Timestamptz(6)
  category      Category       @relation(fields: [categoryId], references: [id])
  pool          Pool?          @relation(fields: [poolId], references: [id])
  studentClasses StudentClass[]
  classTeachers ClassTeacher[]
  classSchedules ClassSchedule[]
  classCategories ClassCategory[]
  attendanceRecords AttendanceRecord[]

  @@map("classes")
}

model AttendanceRecord {
  id            String           @id @default(uuid()) @db.Uuid
  studentId     String           @map("student_id") @db.Uuid
  classId       String           @map("class_id") @db.Uuid
  date          DateTime         @db.Date
  status        AttendanceStatus
  observations  String           @default("")
  savedAt       DateTime?        @map("saved_at") @db.Timestamptz(6)
  createdAt     DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  student       Student          @relation(fields: [studentId], references: [id])
  swimmingClass SwimmingClass    @relation(fields: [classId], references: [id])

  @@unique([studentId, classId, date])
  @@map("attendance_records")
  @@index([classId, date])
  @@index([studentId, date])
  @@index([createdAt])
}

model StudentClass {
  id        String    @id @default(uuid()) @db.Uuid
  studentId String    @map("student_id") @db.Uuid
  classId   String    @map("class_id") @db.Uuid
  isPrimary Boolean   @default(false) @map("is_primary")
  fromDate  DateTime  @default(now()) @map("from_date") @db.Date
  toDate    DateTime? @map("to_date") @db.Date
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  student   Student   @relation(fields: [studentId], references: [id])
  swimmingClass SwimmingClass @relation(fields: [classId], references: [id])

  @@map("student_classes")
  @@index([studentId, toDate])
  @@index([classId, toDate])
  @@index([studentId, classId, toDate])
  @@index([classId, fromDate, toDate])
}

model Pool {
  id           String         @id @default(uuid()) @db.Uuid
  name         String
  lengthMeters Int            @default(25) @map("length_meters")
  address      String         @default("")
  status       PoolStatus     @default(Ativa)
  maxCapacity  Int?           @map("max_capacity")
  createdAt    DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime       @default(now()) @map("updated_at") @db.Timestamptz(6)
  swimmingClasses SwimmingClass[]
  trainings    Training[]

  @@map("pools")
  @@index([status, name])
}

model Training {
  id                  String         @id @default(uuid()) @db.Uuid
  title               String
  description         String         @default("")
  type                TipoTreino
  dayOfWeek           String         @map("day_of_week")
  venueType           TrainingVenueType @default(Piscina) @map("venue_type")
  locationName        String         @default("") @map("location_name")
  startTime           DateTime       @map("start_time") @db.Time(6)
  endTime             DateTime       @map("end_time") @db.Time(6)
  instructorId        String?        @map("instructor_id") @db.Uuid
  level               NivelTreino    @default(Iniciante)
  maxParticipants     Int            @default(0) @map("max_participants")
  currentParticipants Int            @default(0) @map("current_participants")
  status              TrainingStatus @default(Ativo)
  poolId              String?        @map("pool_id") @db.Uuid
  createdAt           DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime       @default(now()) @map("updated_at") @db.Timestamptz(6)
  instructor          Teacher?       @relation(fields: [instructorId], references: [id])
  pool                Pool?          @relation(fields: [poolId], references: [id])

  @@map("trainings")
  @@index([instructorId, dayOfWeek])
  @@index([poolId, dayOfWeek])
  @@index([status, level])
}

model TeacherCategory {
  id         String   @id @default(uuid()) @db.Uuid
  teacherId  String   @map("teacher_id") @db.Uuid
  categoryId String   @map("category_id") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  teacher    Teacher  @relation(fields: [teacherId], references: [id])
  category   Category @relation(fields: [categoryId], references: [id])

  @@unique([teacherId, categoryId])
  @@map("teacher_categories")
}

model ClassCategory {
  id         String        @id @default(uuid()) @db.Uuid
  classId    String        @map("class_id") @db.Uuid
  categoryId String        @map("category_id") @db.Uuid
  isPrimary  Boolean       @default(false) @map("is_primary")
  swimmingClass SwimmingClass @relation(fields: [classId], references: [id])
  category   Category      @relation(fields: [categoryId], references: [id])

  @@unique([classId, categoryId])
  @@map("class_categories")
}

model ClassSchedule {
  id          String        @id @default(uuid()) @db.Uuid
  classId      String        @map("class_id") @db.Uuid
  dayOfWeek    String        @map("day_of_week")
  startTime    DateTime      @map("start_time") @db.Time(6)
  endTime      DateTime      @map("end_time") @db.Time(6)
  createdAt    DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  swimmingClass SwimmingClass @relation(fields: [classId], references: [id])

  @@unique([classId, dayOfWeek, startTime, endTime])
  @@map("class_schedules")
}

model TeacherCertification {
  id        String   @id @default(uuid()) @db.Uuid
  teacherId String   @map("teacher_id") @db.Uuid
  name      String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  teacher   Teacher  @relation(fields: [teacherId], references: [id])

  @@map("teacher_certifications")
}

model ClassTeacher {
  id            String        @id @default(uuid()) @db.Uuid
  classId       String        @map("class_id") @db.Uuid
  teacherId     String        @map("teacher_id") @db.Uuid
  role          CoachRole     @default(assistant_coach)
  createdAt     DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  swimmingClass SwimmingClass @relation(fields: [classId], references: [id])
  teacher       Teacher       @relation(fields: [teacherId], references: [id])

  @@unique([classId, teacherId])
  @@map("class_teachers")
  @@index([classId, role])
  @@index([teacherId])
}

/*
 * Assessment history is append-friendly: a student's physical measurements and
 * technical evaluation scores change over time and must not be stored on Student.
 * All anthropometric measurements use cm or kg, never mixed units or empty strings.
 * BMI and body proportions are derived values; do not persist them as primary facts.
 *
 * The first Neon baseline will require reviewed SQL CHECK constraints for positive
 * measurements and score ranges. Prisma does not describe CHECK constraints.
 */
model AnthropometricAssessment {
  id                  String    @id @default(uuid()) @db.Uuid
  studentId           String    @map("student_id") @db.Uuid
  measuredOn          DateTime  @map("measured_on") @db.Date
  heightCm            Decimal?  @map("height_cm") @db.Decimal(6, 2)
  bodyMassKg          Decimal?  @map("body_mass_kg") @db.Decimal(6, 2)
  armSpanCm           Decimal?  @map("arm_span_cm") @db.Decimal(6, 2)
  legLengthCm         Decimal?  @map("leg_length_cm") @db.Decimal(6, 2)
  footLengthCm        Decimal?  @map("foot_length_cm") @db.Decimal(6, 2)
  handLengthCm        Decimal?  @map("hand_length_cm") @db.Decimal(6, 2)
  trunkLengthCm       Decimal?  @map("trunk_length_cm") @db.Decimal(6, 2)
  measurementMethod   String?   @map("measurement_method") @db.VarChar(120)
  notes               String?
  assessorTeacherId   String?   @map("assessor_teacher_id") @db.Uuid
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  student             Student   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  assessor            Teacher?  @relation("AnthropometricAssessor", fields: [assessorTeacherId], references: [id], onDelete: SetNull)

  @@map("anthropometric_assessments")
  @@index([studentId, measuredOn])
  @@index([assessorTeacherId])
}

// Templates are versioned, so existing assessments preserve their rubric.
model TechnicalAssessmentTemplate {
  id          String                         @id @default(uuid()) @db.Uuid
  name        String
  version     Int                            @default(1)
  description String?
  isActive    Boolean                        @default(true) @map("is_active")
  createdAt   DateTime                       @default(now()) @map("created_at") @db.Timestamptz(6)
  criteria    TechnicalAssessmentCriterion[]
  assessments StudentTechnicalAssessment[]

  @@unique([name, version])
  @@map("technical_assessment_templates")
}

model TechnicalAssessmentCriterion {
  id          String                       @id @default(uuid()) @db.Uuid
  templateId  String                       @map("template_id") @db.Uuid
  code        String                       @db.VarChar(64)
  name        String
  description String?
  style       SwimmingStyle?
  minScore    Int                          @default(0) @map("min_score")
  maxScore    Int                          @default(5) @map("max_score")
  sortOrder   Int                          @default(0) @map("sort_order")
  template    TechnicalAssessmentTemplate  @relation(fields: [templateId], references: [id], onDelete: Restrict)
  scores      TechnicalAssessmentScore[]

  @@unique([id, templateId])
  @@unique([templateId, code])
  @@index([templateId, sortOrder])
  @@map("technical_assessment_criteria")
}

model StudentTechnicalAssessment {
  id                String                      @id @default(uuid()) @db.Uuid
  studentId         String                      @map("student_id") @db.Uuid
  templateId        String                      @map("template_id") @db.Uuid
  assessedOn        DateTime                    @map("assessed_on") @db.Date
  completedAt       DateTime?                   @map("completed_at") @db.Timestamptz(6)
  assessorTeacherId String?                     @map("assessor_teacher_id") @db.Uuid
  notes             String?
  createdAt         DateTime                    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime                    @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  student           Student                     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  template          TechnicalAssessmentTemplate @relation(fields: [templateId], references: [id], onDelete: Restrict)
  assessor          Teacher?                    @relation("TechnicalAssessor", fields: [assessorTeacherId], references: [id], onDelete: SetNull)
  scores            TechnicalAssessmentScore[]

  // The pair allows composite FKs on TechnicalAssessmentScore to prevent
  // attaching a score for a criterion from an unrelated template.
  @@unique([id, templateId])
  @@index([studentId, assessedOn])
  @@index([templateId, assessedOn])
  @@index([assessorTeacherId])
  @@map("student_technical_assessments")
}

model TechnicalAssessmentScore {
  id           String                       @id @default(uuid()) @db.Uuid
  assessmentId String                       @map("assessment_id") @db.Uuid
  templateId   String                       @map("template_id") @db.Uuid
  criterionId  String                       @map("criterion_id") @db.Uuid
  score        Decimal?                     @db.Decimal(5, 2)
  notes        String?
  createdAt    DateTime                     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime                     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  assessment   StudentTechnicalAssessment   @relation(fields: [assessmentId, templateId], references: [id, templateId], onDelete: Cascade, onUpdate: NoAction)
  criterion    TechnicalAssessmentCriterion @relation(fields: [criterionId, templateId], references: [id, templateId], onDelete: Restrict, onUpdate: NoAction)

  @@unique([assessmentId, criterionId])
  @@index([criterionId, templateId])
  @@map("technical_assessment_scores")
}

model StudentLevelHistory {
  id                 String    @id @default(uuid()) @db.Uuid
  studentId          String    @map("student_id") @db.Uuid
  previousLevelId    String?   @map("previous_level_id") @db.Uuid
  nextLevelId        String    @map("next_level_id") @db.Uuid
  effectiveOn        DateTime  @map("effective_on") @db.Date
  assessorTeacherId  String?   @map("assessor_teacher_id") @db.Uuid
  notes              String?
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  student            Student   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  previousLevel      Level?    @relation("PreviousStudentLevel", fields: [previousLevelId], references: [id], onDelete: Restrict)
  nextLevel          Level     @relation("NewStudentLevel", fields: [nextLevelId], references: [id], onDelete: Restrict)
  assessor           Teacher?  @relation("LevelChangeAssessor", fields: [assessorTeacherId], references: [id], onDelete: SetNull)

  @@index([studentId, effectiveOn])
  @@index([nextLevelId])
  @@index([assessorTeacherId])
  @@map("student_level_history")
}

// Canonical pool performances. Pool lengths (20/25/50m etc.) are numeric and
// comparable ONLY for the same distance, stroke, pool length and individual format.
model PoolResult {
  id                  String           @id @default(uuid()) @db.Uuid
  studentId           String           @map("student_id") @db.Uuid
  seasonId            String?          @map("season_id") @db.Uuid
  eventId             String?          @map("event_id") @db.Uuid
  heldOn              DateTime         @map("held_on") @db.Date
  distanceMeters      Int              @map("distance_meters")
  poolLengthMeters    Decimal?         @map("pool_length_meters") @db.Decimal(6, 2)
  style               SwimmingStyle
  format              PoolResultFormat @default(INDIVIDUAL)
  status              RaceResultStatus @default(PENDING)
  durationMs          Int?             @map("duration_ms")
  position            Int?
  categorySnapshot    String?          @map("category_snapshot")
  competitionSnapshot String?          @map("competition_snapshot")
  notes               String?
  createdAt           DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime         @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  student             Student          @relation(fields: [studentId], references: [id], onDelete: Restrict)
  season              Season?          @relation(fields: [seasonId], references: [id], onDelete: SetNull)
  event               Event?           @relation(fields: [eventId], references: [id], onDelete: SetNull)

  @@map("pool_results")
  @@index([studentId, heldOn])
  @@index([studentId, style, distanceMeters, poolLengthMeters])
  @@index([style, distanceMeters, poolLengthMeters, status, durationMs])
  @@index([eventId])
  @@index([seasonId, heldOn])
}

// Open-water course and environmental conditions are not equivalent to a pool.
// Race durations across different courses/tides must never become automatic PBs.
model OpenWaterResult {
  id                  String                @id @default(uuid()) @db.Uuid
  studentId           String                @map("student_id") @db.Uuid
  seasonId            String?          @map("season_id") @db.Uuid
  eventId             String?               @map("event_id") @db.Uuid
  heldOn              DateTime              @map("held_on") @db.Date
  distanceMeters      Int                   @map("distance_meters")
  bodyType            OpenWaterBodyType?    @map("body_type")
  routeKey            String?               @map("route_key")
  style               SwimmingStyle?
  format              OpenWaterResultFormat @default(TRAVESSIA)
  status              RaceResultStatus      @default(PENDING)
  durationMs          Int?                  @map("duration_ms")
  position            Int?
  categorySnapshot    String?               @map("category_snapshot")
  competitionSnapshot String?               @map("competition_snapshot")
  notes               String?
  createdAt           DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime              @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  student             Student               @relation(fields: [studentId], references: [id], onDelete: Restrict)
  season              Season?          @relation(fields: [seasonId], references: [id], onDelete: SetNull)
  event               Event?                @relation(fields: [eventId], references: [id], onDelete: SetNull)

  @@map("open_water_results")
  @@index([studentId, heldOn])
  @@index([studentId, distanceMeters, bodyType])
  @@index([eventId, status])
  @@index([seasonId, heldOn])
}
